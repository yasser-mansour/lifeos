# Copy to .env only if you need to override a default — LIFEOS works with
# none of these set (SECRET_KEY is generated and cached automatically).

# LIFEOS_SECRET_KEY=
# LIFEOS_DEBUG=true
# LIFEOS_DB_PATH=
# LIFEOS_DEFAULT_CURRENCY=MAD
# LIFEOS_TIME_ZONE=Africa/Casablanca
# LIFEOS_PORT=8420
# LIFEOS_HOST=127.0.0.1
